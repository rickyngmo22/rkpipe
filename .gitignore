# build artifacts
build*/
*.o
# 闭源核心库:本仓库(私库)全量备份入库;发布公库时由 scripts/publish_public.sh 剔除,
# 公库用户从 Releases 下载(见 README "开源边界")
*.a
!prebuilt/**/*.a
# RKNN Runtime 随仓库分发(遵循 Rockchip 许可,见 NOTICE)
*.so
*.so.*
!3rdparty/rknn/*.so*

# secrets & local runtime files — 严禁入库
*.key
*.crt
*.pem
auto.*
nohup.out
deploy/
# 私库↔公库内部同步清单,属内部工件,不发布
scripts/.synced_files.txt

/video/
/test_videos/
/test_images/
/test_frames/
/*.rknn
/onnx/
/data/
/coco_eval/
/eval_runs/
/web_runs/
/uploads/
/datasets/
# 板端本地演示配置(含本机素材路径),不入库;模板见 examples/configs/
/demo_*.yaml

# editors / OS
.vscode/
.idea/
__pycache__/
*.pyc
.DS_Store

# AI 会话内部工件,不入库
.zcode/
multistream_logs/
results/
web_runs_archive_*.tar.gz
*.bak.*

# rk_pipe_daemon 运行时产物（任务 yaml/log/snapshot）
daemon_runs/
daemon_smoke.log

# 内网板卡清单与内部设计文档不入开源仓
tools/eval/boards.yaml
tools/eval/远程评测与数据集框架设计.md

# 线框诊断用证据数据（dump + 截图，体积大且非源码）
tools/evidence/
